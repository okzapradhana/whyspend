{
  "name": "whyspend-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @whyspend/web dev",
    "dev:api": "pnpm --filter @whyspend/api dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=!@whyspend/web-e2e",
    "test:e2e": "pnpm --filter @whyspend/web e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:start": "node scripts/local-postgres.mjs start",
    "db:stop": "node scripts/local-postgres.mjs stop",
    "db:status": "node scripts/local-postgres.mjs status",
    "db:start:docker": "docker compose up -d postgres",
    "db:stop:docker": "docker compose stop postgres",
    "db:generate": "pnpm --filter @whyspend/api db:generate",
    "db:push": "pnpm --filter @whyspend/api db:push",
    "db:migrate": "pnpm --filter @whyspend/api db:migrate",
    "db:seed": "pnpm --filter @whyspend/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.0.12"
  }
}
